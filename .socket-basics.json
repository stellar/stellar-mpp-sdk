{
  "workspace": ".",
  "javascript_sast_enabled": true,
  "javascript_disabled_rules": "js-unhandled-promise-rejection",
  "sast_ignore_overrides": "js-code-injection-eval:sdk/src/shared/simulate.ts,js-code-injection-eval:sdk/src/shared/timeout.ts,js-sensitive-data-in-logs:sdk/src/channel/server/Channel.ts,js-sensitive-data-in-logs:sdk/src/charge/server/Charge.ts",
  "secret_scanning_enabled": true,
  "console_tabular_enabled": true,
  "socket_tier_1_enabled": false,
  "trivy_vuln_enabled": false,
  "trufflehog_exclude_dir": "node_modules,dist,build,.git,yarn.lock,package-lock.json,pnpm-lock.yaml,Cargo.lock,go.sum,poetry.lock,Gemfile.lock,composer.lock"
}
